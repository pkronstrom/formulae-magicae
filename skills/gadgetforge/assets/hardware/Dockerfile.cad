FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libx11-6 libxrender1 libglib2.0-0 libosmesa6 && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir cadquery==2.5.2 cadquery-ocp==7.7.2
RUN python3 -m pip install --no-cache-dir --extra-index-url https://wheels.vtk.org vtk-osmesa==9.3.1
